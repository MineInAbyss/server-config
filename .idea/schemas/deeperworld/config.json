{
  "$ref": "#/$defs/com.mineinabyss.deeperworld.DeeperWorldConfig",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "com.mineinabyss.deeperworld.DeeperWorldConfig": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/com.mineinabyss.deeperworld.datastructures.SectionConfig"
          }
        },
        "damageOutsideSections": {
          "type": "number",
          "description": "Damage dealt per movement when outside a managed section, applied as a tenth of this value and bypassing armor."
        },
        "damageExcludedWorlds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Worlds which shouldn't damage players when outside of a section."
        },
        "fall": {
          "$ref": "#/$defs/com.mineinabyss.deeperworld.DeeperWorldConfig.FallDamageConfig"
        },
        "time": {
          "$ref": "#/$defs/com.mineinabyss.deeperworld.DeeperWorldConfig.TimeConfig"
        },
        "sync": {
          "$ref": "#/$defs/com.mineinabyss.deeperworld.DeeperWorldConfig.SyncConfig"
        },
        "bedrockBlockingInvalidTeleport": {
          "type": "boolean"
        },
        "worlds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "com.mineinabyss.deeperworld.datastructures.SectionConfig": {
      "type": "object",
      "required": [
        "name",
        "region",
        "refTop",
        "refBottom"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "region": {
          "$ref": "#/$defs/com.mineinabyss.deeperworld.datastructures.Region"
        },
        "world": {
          "type": "string"
        },
        "refTop": {
          "type": "string"
        },
        "refBottom": {
          "type": "string",
          "description": "refBottom should connect to the refTop of the next section."
        }
      }
    },
    "com.mineinabyss.deeperworld.datastructures.Region": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "com.mineinabyss.deeperworld.DeeperWorldConfig.FallDamageConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether to deal damage when falling long distances."
        },
        "maxSafeDist": {
          "type": "number",
          "description": "The maximum safe falling distance, after which players will start taking damage. Set to -1 to disable falling damage"
        },
        "fallDistanceDamageScaler": {
          "type": "number",
          "description": "The multiplier for damage taken while falling. Set to 0 to deal consistent damage."
        },
        "startingDamage": {
          "type": "number",
          "description": "The minimum damage to deal."
        },
        "hitDelay": {
          "$ref": "#/$defs/com.mineinabyss.DurationSerializer",
          "description": "How often to damage players in ticks"
        },
        "spawnParticles": {
          "type": "boolean",
          "description": "Whether to spawn cloud particles when the player is being damaged."
        }
      }
    },
    "com.mineinabyss.DurationSerializer": {
      "type": "string",
      "pattern": "^(-?\\(?(\\d+(\\.\\d+)?(ns|us|ms|t|s|m|h|d|w|mo) ?)+\\)?|-?P[0-9DTHMS.,-]+|-?Infinity)$",
      "title": "Duration"
    },
    "com.mineinabyss.deeperworld.DeeperWorldConfig.TimeConfig": {
      "type": "object",
      "properties": {
        "updateInterval": {
          "$ref": "#/$defs/com.mineinabyss.DurationSerializer",
          "description": "How often to synchronize time between worlds"
        },
        "mainWorld": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "description": "The main synchronization world. Other worlds will get synchronized based on the time in this world."
            }
          ]
        },
        "syncedWorlds": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "The worlds where time should be synchronized with the mainWorld. Optionally specify a time offset (leave 0 if no offset is desired)"
        }
      }
    },
    "com.mineinabyss.deeperworld.DeeperWorldConfig.SyncConfig": {
      "type": "object",
      "properties": {
        "defaultMode": {
          "$ref": "#/$defs/com.mineinabyss.deeperworld.DeeperWorldConfig.SyncMode",
          "description": "Mode used by /dw sync when none is given. NATIVE needs no other plugins, FAWE requires FastAsyncWorldEdit"
        },
        "confirmAboveBlocks": {
          "type": "integer",
          "description": "Native syncs copying more blocks than this must be confirmed with /dw sync confirm"
        },
        "nativeTimePerTick": {
          "$ref": "#/$defs/com.mineinabyss.DurationSerializer",
          "description": "Main thread time native syncs may spend copying blocks each tick"
        }
      }
    },
    "com.mineinabyss.deeperworld.DeeperWorldConfig.SyncMode": {
      "enum": [
        "NATIVE",
        "FAWE"
      ]
    }
  }
}
