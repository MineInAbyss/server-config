      ]
    },
    "co.touchlab.kermit.Severity": {
      "enum": [
        "Verbose",
        "Debug",
        "Info",
        "Warn",
        "Error",
        "Assert"
      ]
    },
    "com.mineinabyss.geary.papermc.ResourcePack": {
      "type": "object",
      "properties": {
        "generate": {
          "type": "boolean"
        },
        "outputPath": {
          "type": "string",
          "description": "The path to generate the pack to from `plugins/Geary`\nAdding .zip to path will export as a zip instead of directory"
        },
        "includedPackPath": {
          "type": "string",
          "description": "Points to a resourcepack in zip or directory format to merge into Geary's pack"
        }
      }
    },
    "com.mineinabyss.geary.papermc.MenusConfig": {
      "type": "object",
      "properties": {
        "mainTitle": {
          "type": "string",
          "description": "Emojy title of the main menu, the sections open below it"
        },
        "gridTitle": {
          "type": "string",
          "description": "Emojy title of a section grid, 8 columns wide with the buttons in the right column"
        },
        "searchTitle": {
          "type": "string",
          "description": "Emojy title of the search dialog"
        },
        "scrollMode": {
          "$ref": "#/$defs/com.mineinabyss.geary.papermc.ScrollMode",
          "description": "SCROLLING moves one row at a time, PAGINATED swaps the whole grid"
        },
        "scrollbarModel": {
          "type": "string",
          "description": "Item model the generated resourcepack builds the scrollbar under, see guiy's ScrollbarTrack.kt for the custom model data it reads\nIts textures are read from <model>/<vertical|horizontal>/<start|middle|end|single|thumb>"
        },
        "textures": {
          "$ref": "#/$defs/com.mineinabyss.geary.papermc.MenuTextures",
          "description": "Textures the generated resourcepack puts on the grid buttons"
        }
      }
    },
    "com.mineinabyss.geary.papermc.ScrollMode": {
      "enum": [
        "SCROLLING",
        "PAGINATED"
      ]
    },
    "com.mineinabyss.geary.papermc.MenuTextures": {
      "type": "object",
      "properties": {
        "groupByFoldersOn": {
          "type": "string"
        },
        "groupByFoldersOff": {
          "type": "string"
        }
      }
    },
    "kotlinx.serialization.ContextualSerializer<BaseSerializableItemStack>": {
      "description": "No schema available for kotlinx.serialization.ContextualSerializer<BaseSerializableItemStack>"
    }
  }
}
