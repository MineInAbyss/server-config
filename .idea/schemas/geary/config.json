{
  "$ref": "#/$defs/com.mineinabyss.geary.papermc.GearyPaperConfig",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "com.mineinabyss.geary.papermc.GearyPaperConfig": {
      "type": "object",
      "properties": {
        "entities": {
          "$ref": "#/$defs/com.mineinabyss.geary.papermc.EntityTrackingConfig"
        },
        "items": {
          "$ref": "#/$defs/com.mineinabyss.geary.papermc.ItemTrackingConfig"
        },
        "loading": {
          "$ref": "#/$defs/com.mineinabyss.geary.papermc.GearyPaperConfig.Loading"
        },
        "minecraftFeatures": {
          "type": "boolean",
          "description": "Whether to enable Minecraft-specific features for Geary like event bridging. Requires item and entity tracking to be enabled."
        },
        "actions": {
          "type": "boolean",
          "description": "Whether to enable Geary actions (ex. used for item configs.)"
        },
        "catch": {
          "$ref": "#/$defs/com.mineinabyss.geary.papermc.Catching"
        },
        "mobTypeConversion": {
          "$ref": "#/$defs/com.mineinabyss.geary.papermc.MobTypeConversion"
        },
        "removeVanillaMobTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/org.bukkit.entity.EntityType"
          },
          "description": "List of mob types to remove if they are not entities with Geary prefabs (i.e. vanilla entities)"
        },
        "logLevel": {
          "$ref": "#/$defs/co.touchlab.kermit.Severity"
        },
        "resourcePack": {
          "$ref": "#/$defs/com.mineinabyss.geary.papermc.ResourcePack"
        },
        "spawning": {
          "type": "boolean",
          "description": "Whether to enable Geary's spawning system"
        },
        "menus": {
          "$ref": "#/$defs/com.mineinabyss.geary.papermc.MenusConfig"
        }
      }
    },
    "com.mineinabyss.geary.papermc.EntityTrackingConfig": {
      "type": "object",
      "properties": {
        "trackPlayers": {
          "type": "boolean",
          "description": "Whether players should be tracked as entities in Geary"
        },
        "trackOtherEntities": {
          "type": "boolean",
          "description": "Whether all other Minecraft entities should be tracked as entities in Geary"
        }
      }
    },
    "com.mineinabyss.geary.papermc.ItemTrackingConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "migrateByCustomModelData": {
          "type": "boolean",
          "description": "If an item has no prefabs encoded, try to find its prefab by matching custom model data."
        },
        "autoDiscoverVanillaRecipes": {
          "type": "boolean"
        },
        "passiveSlots": {
          "$ref": "#/$defs/com.mineinabyss.geary.papermc.PassiveSlotsConfig"
        }
      }
    },
    "com.mineinabyss.geary.papermc.PassiveSlotsConfig": {
      "type": "object",
      "properties": {
        "defaultUnlockedSlots": {
          "type": "integer",
          "description": "How many of the 9 passive slots new players start with unlocked"
        },
        "menuTitle": {
          "type": "string",
          "description": "Title of the passive slots menu opened from the recipe book button"
        },
        "lockedSlotItem": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/kotlinx.serialization.ContextualSerializer<BaseSerializableItemStack>",
              "description": "Item shown in locked slots, remove to leave them empty, they reject items either way"
            }
          ]
        }
      }
    },
    "com.mineinabyss.geary.papermc.GearyPaperConfig.Loading": {
      "type": "object",
      "properties": {
        "prefabs": {
          "type": "boolean",
          "description": "Whether to load prefab files located in the Geary plugin folder."
        },
        "recipes": {
          "type": "boolean",
          "description": "Whether to register recipes defined in Geary prefabs"
        }
      }
    },
    "com.mineinabyss.geary.papermc.Catching": {
      "type": "object",
      "properties": {
        "asyncWrite": {
          "$ref": "#/$defs/com.mineinabyss.geary.papermc.CatchType",
          "description": "Whether to throw an error when an entity write operation occurs outside of the server thread."
        },
        "asyncEntityConversion": {
          "$ref": "#/$defs/com.mineinabyss.geary.papermc.CatchType",
          "description": "Whether to throw an error when converting bukkit concepts to geary entities outside of the server thread."
        }
      }
    },
    "com.mineinabyss.geary.papermc.CatchType": {
      "enum": [
        "ERROR",
        "IGNORE",
        "WARN"
      ]
    },
    "com.mineinabyss.geary.papermc.MobTypeConversion": {
      "enum": [
        "MIGRATE",
        "REMOVE",
        "IGNORE"
      ]
    },
