{
  "$ref": "#/$defs/geary:spread_entities_types",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "geary:spread_entities_types": {
      "type": "object",
      "properties": {
        "types": {
          "$ref": "#/$defs/kotlin.collections.LinkedHashMap"
        },
        "spawnDelay": {
          "type": "integer"
        },
        "worldName": {
          "type": "string"
        },
        "clearSpawnsOlderThan": {
          "$ref": "#/$defs/com.mineinabyss.DurationSerializer"
        }
      }
    },
    "kotlin.collections.LinkedHashMap": {
      "type": "object"
    },
    "com.mineinabyss.DurationSerializer": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?(ms|t|s|m|h|d|w|mo)$",
      "title": "Duration"
    }
  }
}
