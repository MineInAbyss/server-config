{
  "model": {
    "type": "condition",
    "property": "using_item",
    "on_true": {
      "type": "range_dispatch",
      "property": "custom_model_data",
      "entries": [],
      "fallback": {
        "type": "range_dispatch",
        "property": "use_duration",
        "scale": 0.05,
        "entries": [
          {
            "threshold": 0.65,
            "model": {
              "type": "model",
              "model": "item/bow_pulling_1"
            }
          },
          {
            "threshold": 0.9,
            "model": {
              "type": "model",
              "model": "item/bow_pulling_2"
            }
          }
        ],
        "fallback": {
          "type": "model",
          "model": "item/bow_pulling_0"
        }
      }
    },
    "on_false": {
      "type": "range_dispatch",
      "property": "custom_model_data",
      "entries": [],
      "fallback": {
        "type": "model",
        "model": "item/bow"
      }
    }
  }
}